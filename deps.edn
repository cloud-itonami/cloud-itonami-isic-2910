{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). It lives
 ;; in the kotoba-lang org of this workspace (transferred + renamed from
 ;; com-junkawasaki/langgraph-clj / com-junkawasaki/langchain-clj). This
 ;; repo is standalone (forkable outside the workspace); the :local/root
 ;; paths only resolve inside the monorepo checkout — a standalone fork
 ;; should override them with git coordinates.
 :deps {io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}
        io.github.kotoba-lang/robotics
        {:local/root "../../kotoba-lang/robotics"}
        ;; REAL engineering-simulation dependency (ADR-2607151600, amending
        ;; ADR-2607083500's "zero dependency / opaque payload" wall for the
        ;; automotive vertical ONLY): automotive.robotics now actually calls
        ;; vdesign.simphysics/vdesign.scene/vdesign.motionplan -- a real
        ;; physics-2d-backed time-stepped rigid-body crash-dispatch
        ;; simulation, a real tessellated-mesh scene bridge and a real
        ;; Cartesian assembly-station motion plan -- instead of comparing
        ;; static self-reported fields. physics-2d/org-iso-10303/org-iso-6983/
        ;; cad resolve transitively from this git dep's own deps.edn.
        io.github.kotoba-lang/kami-engine-vehicle-designer
        {:git/url "https://github.com/kotoba-lang/kami-engine-vehicle-designer.git"
         :sha "09f9c57cb27acc53ac5cb241e72f9b582d202bc3"}
        ;; Cross-actor supply-chain-linkage contract (ADR-2607999950,
        ;; extended by ADR-2607999960): `automotive.governor`
        ;; independently re-verifies each OPTIONAL entry of
        ;; `:upstream-part-pedigrees` (a `kotoba.pedigree` record an
        ;; upstream isic-2930 part-lot issued via `autoparts.export/
        ;; pedigree-for-part-lot`) before accepting it as evidence a
        ;; vehicle's incoming part-lot clears this actor's own
        ;; acceptance floor. A real pinned git-coordinate dep (not
        ;; :local/root), same reasoning as kami-engine-vehicle-designer
        ;; above -- SAME SHA `cloud-itonami-isic-2930`'s own deps.edn
        ;; pins (the SHA that added :pedigree/upstream chaining
        ;; support).
        io.github.kotoba-lang/pedigree
        {:git/url "https://github.com/kotoba-lang/pedigree.git"
         :sha "f85784211422a651fea26f448f601abfba2e7d61"}}
 :aliases
 {;; offline workspace dev -- pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; clojure -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "automotive.sim"]}
  :export {:main-opts ["-m" "automotive.export-run"]}
  ;; clojure -M:dev:render-html -> build-time regeneration of
  ;; docs/samples/operator-console.html through the real actor
  ;; (ADR-2607189300 checklist item 2 / flagship-wave5 ledger seq 4).
  :render-html {:main-opts ["-m" "automotive.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; ADR-2607999970 extends this to the genuine FULL 3-hop, 4-actor
  ;; chain (iron ore -> steel -> part -> vehicle): ALSO a real
  ;; cross-repo call two hops further back into cloud-itonami-
  ;; isic-0710's own `ironops.export`/`ironops.store` (a real
  ;; production record, written and read back through that repo's OWN
  ;; store -> a real kotoba.pedigree record), attached to the heat as
  ;; its own `:upstream-ore-pedigree` BEFORE calling isic-2410's
  ;; `pedigree-for-heat`, so the part pedigree this actor receives
  ;; carries a genuinely 2-level-deep `:pedigree/upstream` chain
  ;; (steel embeds ore) beneath ITS OWN top level. isic-0710 is
  ;; needed directly here too, same reasoning as isic-2410 below.
  ;;
  ;; ADR-2607999960's critical end-to-end proof: a GENUINE cross-repo
  ;; call into cloud-itonami-isic-2930's own `autoparts.export`/
  ;; `autoparts.robotics` (a real part-lot -> a real physics-2d
  ;; simulation -> a real kotoba.pedigree record), fed as plain EDN
  ;; into this actor's governor -- and, for the genuine 2-hop proof,
  ;; ALSO a real cross-repo call one hop further back into
  ;; cloud-itonami-isic-2410's own `steelworks.export`/`steelworks.
  ;; robotics` (a real heat -> a real physics-2d simulation -> a real
  ;; kotoba.pedigree record), attached to the part-lot as its own
  ;; `:upstream-pedigree` BEFORE calling isic-2930's `pedigree-for-
  ;; part-lot`, so the resulting part pedigree genuinely embeds the
  ;; steel pedigree (`:pedigree/upstream`). isic-2410 is needed
  ;; directly here (not only transitively through isic-2930) because
  ;; tools.deps does NOT compose another :local/root dependency's own
  ;; ALIAS-scoped deps -- isic-2930's OWN `:cross-repo-test` alias
  ;; dependency on isic-2410 is invisible from here; this alias
  ;; declares both siblings itself, the same workspace-sibling
  ;; :local/root convention `io.github.kotoba-lang/langgraph`/
  ;; `robotics` above already use, one org level up instead of across
  ;; orgs. Kept out of the default :test alias (and its own
  ;; test-cross-repo/ source root) so plain `clojure -M:dev:test`
  ;; never REQUIRES same-org sibling checkouts a casual fork of just
  ;; this repo would not have. Still no live network call at runtime:
  ;; this is a build-time classpath dependency exercised by tests, the
  ;; same category as every other :local/root dep in this fleet.
  :cross-repo-test
  {:extra-paths ["test-cross-repo"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                io.github.cloud-itonami/cloud-itonami-isic-2930
                {:local/root "../cloud-itonami-isic-2930"}
                io.github.cloud-itonami/cloud-itonami-isic-2410
                {:local/root "../cloud-itonami-isic-2410"}
                io.github.cloud-itonami/cloud-itonami-isic-0710
                {:local/root "../cloud-itonami-isic-0710"}}
   :main-opts ["-m" "cognitect.test-runner" "-d" "test-cross-repo"]
   :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test" "test-cross-repo"
                        "--fail-level" "error"]}}}
